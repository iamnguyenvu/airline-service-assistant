# ========================================
# Google AI Studio Configuration (Production)
# ========================================
# Get your FREE API key at: https://aistudio.google.com/app/apikey
# No billing account required, unlimited usage

GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# Available models:
# - gemini-2.0-flash-exp (fastest, recommended)
# - gemini-1.5-pro (most capable)
# - gemini-1.5-flash (balanced)

# ========================================
# Ollama Configuration (Development)
# ========================================
# Local LLM for development (free, unlimited)

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Setup:
# 1. Download Ollama: https://ollama.com
# 2. Pull models:
#    ollama pull llama3.1:8b
#    ollama pull nomic-embed-text

# ========================================
# Database Configuration (PostgreSQL)
# ========================================

DATABASE_URL=jdbc:postgresql://localhost:5432/airline_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# For Supabase (production):
# DATABASE_URL=jdbc:postgresql://db.xxx.supabase.co:5432/postgres
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=your_supabase_password

# ========================================
# Redis Configuration
# ========================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# For Upstash/Redis Cloud (production):
# REDIS_HOST=redis-12345.upstash.io
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password

# ========================================
# Spring Profile Configuration
# ========================================
# dev  = Ollama (local, free, unlimited)
# prod = Google AI Studio (cloud, free, unlimited)

SPRING_PROFILES_ACTIVE=dev

# ========================================
# OAuth2 Configuration (Optional - Supabase)
# ========================================

# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
# SUPABASE_JWKS_URI=https://your-project.supabase.co/auth/v1/jwks

# ========================================
# Application Configuration
# ========================================

SERVER_PORT=8080

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_IO_GITHUB_NGUYENVU=DEBUG

# ========================================
# How to Use
# ========================================

# 1. Copy this file:
#    cp .env.example .env

# 2. Get Google AI Studio API Key:
#    https://aistudio.google.com/app/apikey

# 3. Choose profile:
#    - dev  = Ollama (requires docker-compose up -d)
#    - prod = Google AI Studio (only needs GEMINI_API_KEY)

# 4. Start backend:
#    Windows: .\mvnw.cmd spring-boot:run
#    Linux/Mac: ./mvnw spring-boot:run

# 5. Test:
#    curl http://localhost:8080/actuator/health
