# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/airline_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI Configuration
# Google Gemini API Key (FREE from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Ollama Configuration (for local development)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Flight Data API Keys (choose one)
AVIATIONSTACK_API_KEY=your-aviationstack-api-key
AMADEUS_CLIENT_ID=your-amadeus-client-id
AMADEUS_CLIENT_SECRET=your-amadeus-client-secret

# Supabase Configuration (Optional - for production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URI=https://your-project.supabase.co/auth/v1/jwks
SUPABASE_STORAGE_URL=https://your-project.supabase.co/storage/v1

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.com

# Spring Profile
SPRING_PROFILES_ACTIVE=dev
